# ── Server & Environment ──────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Auth ─────────────────────────────────────────────────────
AUTH_SECRET=generate_a_long_random_secret_for_jwt_and_encryption

# ── LLM Configuration ────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# ── 1. Admin & Auth Database: Supabase Cloud PostgreSQL ───────
# Dedicated for app users, admin logins, JWT sessions, access control
SUPABASE_ADMIN_DB_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── 2. Primary Query Database: Supabase Cloud PostgreSQL ──────
# Target database for natural language queries & schema discovery
SUPABASE_DB_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Query Engine Constraints ─────────────────────────────────
QUERY_TIMEOUT_MS=10000
MAX_QUERY_ROWS=1000


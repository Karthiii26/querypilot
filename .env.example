# ── Server & Environment ──────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
AUTH_SECRET=generate_a_long_random_secret_for_jwt_and_encryption

# ── LLM Configuration ────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# ── Database: Supabase Cloud PostgreSQL ───────────────────────
# Used for: app users, sessions, and access control
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
SUPABASE_ADMIN_DB_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# (Optional) Default server-side query DB — users can also connect their own via the UI
# SUPABASE_DB_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Query Engine Constraints ─────────────────────────────────
QUERY_TIMEOUT_MS=10000
MAX_QUERY_ROWS=1000

